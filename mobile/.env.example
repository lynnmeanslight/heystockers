# Production is the safe default. Override with http://10.0.2.2:3000 only while
# running the backend locally in an Android emulator.
EXPO_PUBLIC_HEYSTOCKERS_API_URL=https://api.heystockers.trade

# Public mainnet RPC used for wallet transaction helpers only.
# Never place a paid/private RPC key in an EXPO_PUBLIC variable; it is readable from the APK.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
