{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heystockers-testnet",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Devnet / MagicBlock hackathon environment. Completely separate from the
  // production Worker `heystockers` and domain `heystockers.trade`.
  "routes": [
    { "pattern": "testnet.heystockers.trade", "custom_domain": true }
  ]
}
