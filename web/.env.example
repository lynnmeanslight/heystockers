# DFlow's developer endpoint works without a key and is rate-limited.
DFLOW_TRADE_API_URL=https://dev-quote-api.dflow.net

# Add a production key before serving real users.
DFLOW_API_KEY=

# Dedicated provider used only for SPL Token and Token-2022 account discovery.
SOLANA_TOKEN_RPC_URL=

# Used to create absolute social-preview URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
