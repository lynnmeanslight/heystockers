{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heystockers",
  // worker-shell wraps vinext's entry to enforce security headers (see scripts/add-worker-shell.mjs).
  "main": "dist/server/worker-shell.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "routes": [
    { "pattern": "heystockers.trade", "custom_domain": true },
    { "pattern": "www.heystockers.trade", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heystockers",
      "database_id": "5ae67154-750e-45b0-978f-adbae7a86c72"
    }
  ]
}
